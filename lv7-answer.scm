(define lst0 '(12 71 2 15 29 82 87 8 18 66 81 25 63 97 40 3 93 58 53 31 47))
(define (sort lst)
  (if (null? lst)
  '()
  (let ((pivot (car lst))
  (rest (cdr lst)))
  (let ((less (sort (filter ( lambda (x) (< x pivot)) rest)))
    (greater (sort (filter (lambda (x) (>= x pivot)) rest))))
  (append less (list pivot) greater)))
  ))                 
(print (sort lst0))